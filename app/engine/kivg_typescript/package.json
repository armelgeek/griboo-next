{
    "name": "@armelwanes/wb-engine",
    "private": false,
    "version": "0.0.1",
    "description": "Kivg Animation Engine - TypeScript Implementation",
    "targets": {
        "demo": {
            "source": "index.html",
            "distDir": "docs",
            "publicUrl": "./"
        }
    },
    "staticFiles": [
        {
            "staticPath": "static/demo/icons",
            "staticOutPath": "icons"
        },
        {
            "staticPath": "static/assets",
            "staticOutPath": "assets"
        },
        {
            "staticPath": "static/hand",
            "staticOutPath": "hand"
        }
    ],
    "scripts": {
        "start": "parcel index.html --open",
        "build": "npm run build:lib && npm run build:demo",
        "build:lib": "tsc --project tsconfig.build.json",
        "build:demo": "parcel build index.html --target demo --no-source-maps",
        "type-check": "tsc --noEmit",
        "clean": "rm -rf dist parcel-dist .parcel-cache docs-dist_temp",
        "test": "npm run type-check",
        "demo": "npx ts-node --project tsconfig.examples.json examples/server_demo_test.ts",
        "export": "npx ts-node --project tsconfig.examples.json src/server/bin/export_cli.ts",
        "prepublishOnly": "npm run clean && npm run type-check && npm run build:lib"
    },
    "keywords": [
        "animation",
        "doodle",
        "whiteboard",
        "video",
        "rendering"
    ],
    "author": "",
    "license": "ISC",
    "repository": {
        "type": "git",
        "url": "https://github.com/armelgeek/engine.git"
    },
    "bugs": {
        "url": "https://github.com/armelgeek/engine/issues"
    },
    "homepage": "https://github.com/armelgeek/engine#readme",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "require": "./dist/index.js",
            "types": "./dist/index.d.ts"
        },
        "./frontend": {
            "import": "./dist/frontend/index.js",
            "require": "./dist/frontend/index.js",
            "types": "./dist/frontend/index.d.ts"
        },
        "./server": {
            "import": "./dist/server/index.js",
            "require": "./dist/server/index.js",
            "types": "./dist/server/index.d.ts"
        },
        "./shared": {
            "import": "./dist/shared/index.js",
            "require": "./dist/shared/index.js",
            "types": "./dist/shared/index.d.ts"
        },
        "./editor": {
            "import": "./dist/editor/index.js",
            "require": "./dist/editor/index.js",
            "types": "./dist/editor/index.d.ts"
        }
    },
    "files": [
        "dist",
        "static",
        "src",
        "README.md"
    ],
    "publishConfig": {
        "access": "restricted"
    },
    "alias": {
        "engine": "./src/frontend"
    },
    "dependencies": {
        "@techstark/opencv-js": "^4.12.0-release.1",
        "@types/jsdom": "^27.0.0",
        "@types/rbush": "^4.0.0",
        "@types/svg-path-parser": "^1.1.6",
        "@types/uuid": "^10.0.0",
        "buffer": "^6.0.3",
        "canvas": "^3.2.1",
        "crypto-browserify": "^3.12.1",
        "events": "^3.3.0",
        "jsdom": "^27.4.0",
        "konva": "^10.2.0",
        "makerjs": "^0.18.1",
        "opentype.js": "^1.3.4",
        "path-browserify": "^1.0.1",
        "process": "^0.11.10",
        "rbush": "^4.0.1",
        "stream-browserify": "^3.0.0",
        "string_decoder": "^1.3.0",
        "svg-path-parser": "^1.1.0",
        "svg-path-properties": "^2.0.0",
        "uuid": "^10.0.0",
        "vitest": "^4.0.16",
        "vm-browserify": "^1.1.2",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@parcel/config-default": "^2.16.3",
        "@parcel/transformer-typescript-types": "^2.16.3",
        "@types/node": "^22.19.7",
        "parcel": "^2.16.3",
        "parcel-reporter-static-files-copy": "^1.5.3",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3"
    }
}